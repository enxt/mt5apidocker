# Copy to .env and fill in. Do not commit .env.

# --- MetaTrader 5 account ---------------------------------------------------
# The terminal logs in with these at start-up. For any broker other than
# MetaQuotes it also needs config/servers.dat - see the README.
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# History bars kept per chart (the most copy_rates_* can return).
MT5_MAX_BARS=1000000

# --- API --------------------------------------------------------------------
# The API key is sha256(API_KEY_SEED); it is printed in the container log at
# start-up. Empty disables authentication.
API_KEY_SEED=change-me
LOG_LEVEL=INFO

# --- VNC (browser view of the terminal on http://localhost:6901) -----------
# At most 8 characters are used. Empty means no password.
VNC_PASSWORD=password
VNC_GEOMETRY=1280x800

# --- Image ------------------------------------------------------------------
# Uncomment to run the image published by GitHub Actions instead of building.
# MT5_IMAGE=ghcr.io/your-github-user/mt5api:latest
